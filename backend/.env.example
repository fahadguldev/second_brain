# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Sessions
DATABASE_URL=sqlite:///./second_brain.db
SESSION_SECRET=your-super-secret-session-key
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Supabase Auth & Storage (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=second_brain

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=3072
GENERATION_MODEL=gemini-3.1-flash-lite

# JSF Labs Voice API (TTS & Voice Cloning)
# Primary API Key
JSF_API_KEY=your_jsf_api_key_here
# Optional recurring fallback keys (comma-separated or JSF_API_KEY_1, JSF_API_KEY_2...)
# If one key expires or hits a rate limit, the system automatically rotates to the next key!
JSF_API_KEYS=your_first_key,your_second_key
# Cloned Voice ID (from /api/v1/voice-clone)
JSF_VOICE_ID=jsf_your_voice_id_here
# Playback speed multiplier (0.5 to 2.0, default: 1.0)
JSF_TTS_SPEED=1.0
