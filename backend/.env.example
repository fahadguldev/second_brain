# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Sessions
DATABASE_URL=sqlite:///./second_brain.db
SESSION_SECRET=your-super-secret-session-key
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Supabase Auth & Storage (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=second_brain_hybrid

# Hybrid Search (Dense + FastEmbed BM25)
RAG_HYBRID_SEARCH=True
SPARSE_MODEL=Qdrant/bm25
SPARSE_VECTOR_NAME=bm25
RAG_HYBRID_SCORE_THRESHOLD=0.25

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=3072
GENERATION_MODEL=gemini-3.1-flash-lite

# Voice Provider Selection ("elevenlabs", "jsflabs", or "auto")
VOICE_PROVIDER=elevenlabs

# ElevenLabs Voice API (TTS, Conversational Voice Call & Cloned Voices)
# 1. Developer API Key(s) (supports single or comma-separated keys for auto-rotation on quota exhaustion)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_API_KEYS=your_first_key,your_backup_key

# 2. Voice ID (Default: pNInz6obpgDQGcFmaJgB for creator male voice, or your cloned voice ID)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# 3. Model ID (eleven_flash_v2_5 for ultra-low latency real-time voice calls, or eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_LATENCY_OPTIMIZATION=3

# JSF Labs Voice API (Fallback / Alternative Provider)
# 1. Fast Inference Dashboard Session (Optional, uses your dashboard credits directly!)
JSF_USER_ID=your_user_id_from_dashboard_here

# 2. Developer API Key(s)
JSF_API_KEY=your_jsf_api_key_here
# Optional recurring fallback keys (comma-separated or JSF_API_KEY_1, JSF_API_KEY_2...)
JSF_API_KEYS=your_first_key,your_second_key

# Voice ID (Default: jsf_default_male, or your custom cloned voice jsf_...)
JSF_VOICE_ID=jsf_default_male

# Playback speed multiplier (0.5 to 2.0, default: 1.0)
JSF_TTS_SPEED=1.0
