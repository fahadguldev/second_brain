# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Sessions
DATABASE_URL=sqlite:///./second_brain.db
SESSION_SECRET=your-super-secret-session-key
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Supabase Auth & Storage (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=second_brain

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSION=3072
GENERATION_MODEL=gemini-3.1-flash-lite

# Fish Audio API (TTS & ASR)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_VOICE_ID=your_cloned_voice_reference_id_here
FISH_AUDIO_TTS_MODEL=speech-1.5
FISH_AUDIO_ASR_MODEL=transcribe-1-pro
